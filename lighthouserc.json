{
  "ci": {
    "collect": {
      "staticDistDir": "dist/public",
      "url": [
        "/",
        "/booking",
        "/contact",
        "/blog",
        "/tips"
      ]
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", {"minScore": 0.98}],
        "categories:performance": ["warn", {"minScore": 0.9}]
      }
    }
  }
}
